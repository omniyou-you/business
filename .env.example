# PostgreSQL Supabase Connection Strings
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?schema=public"
DIRECT_URL="postgresql://username:password@hostname:5432/database_name"

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your_project_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_cloudflare_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="https://your_public_domain.r2.dev"

# Admin Credentials & Session Secret
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_admin_password_here"
ADMIN_JWT_SECRET="your_random_admin_session_secret"
